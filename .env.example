# Server
AIRING_LISTEN_ADDR=:8090
AIRING_LOG_LEVEL=info

# Security
ZABBIX_WEBHOOK_SECRET=change-me-random-32-bytes-hex
AIRING_API_TOKEN=change-me-random-32-bytes-hex

# Zabbix (event spine)
# ZABBIX_URL=http://zabbix.example.com
# ZABBIX_TOKEN=your-api-token

# LibreNMS (enrichment)
LIBRENMS_URL=http://librenms.example.com
LIBRENMS_API_TOKEN=change-me-librenms-token

# Akvorado (traffic intelligence)
AKVORADO_URL=http://akvorado.example.com

# Optional outbound webhook notifier
# AIRING_NOTIFY_WEBHOOK_URL=https://example.internal/hooks/airing
# AIRING_NOTIFY_WEBHOOK_TOKEN=change-me-webhook-bearer-token

# OLT adapters (optional — initialized when configured)
OLT_ZTE_C320_HOST=
OLT_ZTE_C320_PORT=80
OLT_ZTE_C320_USERNAME=
OLT_ZTE_C320_PASSWORD=
